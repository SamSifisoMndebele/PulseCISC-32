<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Light Mode). -->
    <style name="Theme.pulsecisc_32_desktop" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/light_window_background</item>
        <item name="android:statusBarColor">@color/light_status_bar</item>
        <item name="android:navigationBarColor">@color/light_nav_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>
