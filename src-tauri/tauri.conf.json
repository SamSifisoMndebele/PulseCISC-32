{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseCISC-32 Studio",
  "version": "1.0.0",
  "identifier": "com.pulsecisc32.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PulseCISC-32 Studio — Native x86 IA-32 Simulator (Rust Core)",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 576,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
